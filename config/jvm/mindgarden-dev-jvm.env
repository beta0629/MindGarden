# Dev backend JVM only. Prod units must not load this file.
# Single source for mindgarden-dev.service and the dev start.sh writers.
#
# Host is 4GB. The running dev command is -Xms1g -Xmx4g -XX:+UseG1GC with RSS ~2.1GB,
# so the heap is not committed at the 4g ceiling (RSS would sit well above 2.1GB if it were).
# -Xms512m -Xmx1536m keeps the heap inside the box next to MySQL and nginx.
#
# MaxMetaspaceSize=384m: no live Metaspace reading from this host. Inferred from the app:
# Spring Boot 3.2.1, Hibernate 6.4, Java 17, about 2292 main classes (~352k lines).
# Boot 3 monoliths of this size typically commit ~150-250MB of class metadata after warmup.
# 384m is about 1.5x that band (room for Hibernate/CGLIB proxies) and stops the default
# unlimited metaspace from growing into the RAM left after a 1536m heap.
# Heap 1536m + metaspace 384m = 1920m for those two pools on a 4096m host.
#
# ExitOnOutOfMemoryError and HeapDumpOnOutOfMemoryError are omitted.
# The live dev unit and dev workflows only pass heap size and G1.
# HeapDumpOnOutOfMemoryError appears in deployment/jvm-memory-config.sh, which writes
# a different unit (mindgarden.service) and is not this dev launch path.
JAVA_OPTS="-Xms512m -Xmx1536m -XX:MaxMetaspaceSize=384m -XX:+UseG1GC"

# TEMP (#1738 expiry check on .dev): idle TTL override for every role, read by Spring as session.idle.test-override-seconds.
# Prod profile ignores it. Revert after one 검증 run.
SESSION_IDLE_TEST_OVERRIDE_SECONDS=120
