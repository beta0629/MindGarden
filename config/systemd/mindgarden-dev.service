[Unit]
Description=MindGarden Development Server
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/mindgarden-dev
# 세션 쿠키 도메인 등 OAuth/세션 env 로드 (파일 없으면 무시: -)
EnvironmentFile=-/etc/mindgarden/dev.env
# Dev JVM SSOT: /etc/mindgarden/dev-jvm.env (repo config/jvm/mindgarden-dev-jvm.env).
# Loaded after dev.env so this file wins if dev.env still has JAVA_OPTS.
# Previous 4g heap was for AnomalyDetection warnings; 4GB host RSS was ~2.1GB.
EnvironmentFile=-/etc/mindgarden/dev-jvm.env
ExecStart=/opt/mindgarden/start.sh
Restart=always
RestartSec=10
TimeoutStartSec=120
# Spring Boot graceful shutdown: application.yml lifecycle 30s + task.scheduling.shutdown await 25s 여유
TimeoutStopSec=120
SyslogIdentifier=mindgarden-dev
# stdout/stderr 모두 journal + 파일에 남기기 (journalctl과 dev-error.log에서 예외 확인 가능)
StandardOutput=append:/var/log/mindgarden/dev.log
StandardError=append:/var/log/mindgarden/dev-error.log

[Install]
WantedBy=multi-user.target


