# Public site
NEXT_PUBLIC_SITE_URL=https://staging.m-garden.co.kr
# production only: true (staging must stay false/unset → noindex)
NEXT_PUBLIC_SITE_INDEXABLE=false

# Clinic-OS public API (server-side fetch only — no CORS; revalidate 300)
# Dev example: https://mindgarden.dev.core-solution.co.kr
CLINIC_OS_API_BASE_URL=https://mindgarden.dev.core-solution.co.kr
CLINIC_OS_TENANT_SLUG=mindgarden

# Cloudflare Turnstile (public site key for m-garden.co.kr / www / staging)
# Secret verification is done by Clinic-OS, not this homepage.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF8rDKpWUewMGRcN

# Legacy /api/consultation (kept temporarily; uses MySQL + mail)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONSULTATION_NOTIFY_FROM=
CONSULTATION_NOTIFY_TO=
